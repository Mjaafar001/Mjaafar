// MJ Football Academy — database schema
//
// Conventions
//  - Money is stored as integer kobo (1 NGN = 100 kobo) in *Kobo columns. Never floats.
//  - Columns ending in *Enc hold AES-256-GCM ciphertext produced by src/lib/crypto.ts.
//  - Branch-scoped tables carry branchId so access can be filtered per branch.
//  - Financial and credit records are append-only: corrections are new rows, never deletes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

