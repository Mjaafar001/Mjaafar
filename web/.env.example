# ─── MJ Football Academy — environment template ───
# Copy to .env and fill in. Never commit real values.

# PostgreSQL connection
DATABASE_URL="postgresql://mj:CHANGE_ME@localhost:5432/mj_academy?schema=public"
# Used only by the automated test suite (database name must contain "test")
TEST_DATABASE_URL="postgresql://mj:CHANGE_ME@localhost:5432/mj_academy_test?schema=public"

# Public URL of the app (used in password-setup links and emails)
APP_URL="http://localhost:3000"

# 32-byte keys, base64. Generate each with:  openssl rand -base64 32
# DATA_ENCRYPTION_KEY encrypts medical data and MFA secrets. Losing it makes that data unreadable;
# rotating it requires re-encrypting rows. Store it in a secrets manager and back it up separately.
DATA_ENCRYPTION_KEY="REPLACE"
SESSION_SECRET="REPLACE"

# Require MFA for privileged roles (president, admin, accountant). Defaults to true in production.
MFA_ENFORCE="false"

# File storage: "local" (STORAGE_LOCAL_DIR, private, outside /public) or "s3" (any S3-compatible bucket)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_BUCKET="mj-academy"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Email (optional until Phase 4). Without it, emails are recorded as "not sent — no provider".
# SMTP_URL="smtps://user:password@smtp.example.com:465"
# EMAIL_FROM="MJ Football Academy <no-reply@mjfootball.example>"

# First president account for production bootstrap (npm run db:seed:base)
# SEED_ADMIN_EMAIL="president@your-domain"
# SEED_ADMIN_PASSWORD=""
# SEED_ADMIN_NAME="Academy President"

# ─── Phase 3/4 integrations (credentials required; not used yet) ───
# PAYSTACK_SECRET_KEY="sk_test_..."     # test mode until live deployment is approved
# PAYSTACK_PUBLIC_KEY="pk_test_..."
# WHATSAPP_PROVIDER="meta-cloud"        # official WhatsApp Business Platform only
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
